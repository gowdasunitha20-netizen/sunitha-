	head = insertAtBeginning(head,56);
	head = insertAtBeginning(head,96);
	head = insertAtEnding(head,44);
	head = insertAtEnding(head,78);
	head = insertAtPosition(head,67,3);
	printf("%d\n",searchElement(head,3));
	display(head);
	printf("%d\n",searchElement(head,46));
